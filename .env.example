# Frontend: en production laissez NEXT_PUBLIC_API_URL vide pour utiliser /api sur le même domaine.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Backend / Supabase PostgreSQL
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
JWT_SECRET=generez-un-secret-aleatoire-d-au-moins-32-caracteres
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:3000
SEED_ADMIN_EMAIL=admin@fifa26.control
SEED_ADMIN_PASSWORD=ChangezCeMotDePasse!
